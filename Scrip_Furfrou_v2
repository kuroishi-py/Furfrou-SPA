BEGIN
  FOR t IN (
    SELECT 'TRASLADO'         tn FROM dual UNION ALL
    SELECT 'ESTADIA'             FROM dual UNION ALL
    SELECT 'TRABAJADOR_SEDE'     FROM dual UNION ALL
    SELECT 'TRABAJADOR'          FROM dual UNION ALL
    SELECT 'PERRO'               FROM dual UNION ALL
    SELECT 'DUENO'               FROM dual UNION ALL
    SELECT 'SEDE'                FROM dual UNION ALL
    SELECT 'TIPO_TRABAJO'        FROM dual UNION ALL
    SELECT 'RAZA'                FROM dual UNION ALL
    SELECT 'ESTADO_CIVIL'        FROM dual UNION ALL
    SELECT 'COMUNA'              FROM dual
  ) LOOP
    BEGIN
      EXECUTE IMMEDIATE 'DROP TABLE ' || t.tn || ' CASCADE CONSTRAINTS';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -942 THEN RAISE; END IF;  -- ignora "tabla no existe"
    END;
  END LOOP;
END;
/
 
-- ============================================================================
--  1) TABLAS DE APOYO (LOOKUPS)
-- ============================================================================
 
-- Comuna: ubicacion geografica reutilizada por duenos, trabajadores y sedes
CREATE TABLE COMUNA (
  ID_COMUNA        NUMBER(3)      NOT NULL,
  NOMBRE_COMUNA    VARCHAR2(40)   NOT NULL,
  CONSTRAINT PK_COMUNA PRIMARY KEY (ID_COMUNA)
);
 
-- Estado civil del dueno y del trabajador
CREATE TABLE ESTADO_CIVIL (
  ID_ESTCIVIL      NUMBER(1)      NOT NULL,
  DESC_ESTCIVIL    VARCHAR2(25)   NOT NULL,
  CONSTRAINT PK_ESTADO_CIVIL PRIMARY KEY (ID_ESTCIVIL)
);
 
-- Raza del perro
CREATE TABLE RAZA (
  ID_RAZA          NUMBER(3)      NOT NULL,
  NOMBRE_RAZA      VARCHAR2(40)   NOT NULL,
  CONSTRAINT PK_RAZA PRIMARY KEY (ID_RAZA)
);
 
-- Tipo de trabajo (categoria del trabajador). IND_MULTISEDE indica, como regla
-- de negocio, si ese tipo de trabajo habilita a desempenarse en varias sedes.
CREATE TABLE TIPO_TRABAJO (
  ID_TIPO_TRABAJO  NUMBER(2)      NOT NULL,
  DESC_TIPO_TRABAJO VARCHAR2(40)  NOT NULL,
  IND_MULTISEDE    VARCHAR2(1)    DEFAULT 'N' NOT NULL,
  CONSTRAINT PK_TIPO_TRABAJO PRIMARY KEY (ID_TIPO_TRABAJO),
  CONSTRAINT CK_TTRAB_MULTISEDE CHECK (IND_MULTISEDE IN ('S','N'))
);
 
-- ============================================================================
--  2) ENTIDADES PRINCIPALES
-- ============================================================================
 
-- Sede: establecimiento fisico donde se hospedan los perros
CREATE TABLE SEDE (
  ID_SEDE          NUMBER(3)      NOT NULL,
  NOMBRE_SEDE      VARCHAR2(40)   NOT NULL,
  DIRECCION_SEDE   VARCHAR2(60)   NOT NULL,
  FONO_SEDE        VARCHAR2(15),
  CAPACIDAD_SEDE   NUMBER(4)      NOT NULL,
  ID_COMUNA        NUMBER(3)      NOT NULL,
  CONSTRAINT PK_SEDE PRIMARY KEY (ID_SEDE),
  CONSTRAINT FK_SEDE_COMUNA
    FOREIGN KEY (ID_COMUNA) REFERENCES COMUNA (ID_COMUNA),
  CONSTRAINT CK_SEDE_CAPACIDAD CHECK (CAPACIDAD_SEDE > 0)
);
 
-- Dueno: persona responsable de uno o mas perros (contrata el servicio)
CREATE TABLE DUENO (
  NUMRUT_DUENO     NUMBER(10)     NOT NULL,
  DVRUT_DUENO      VARCHAR2(1)    NOT NULL,
  APPATERNO_DUENO  VARCHAR2(20)   NOT NULL,
  APMATERNO_DUENO  VARCHAR2(20),
  NOMBRE_DUENO     VARCHAR2(30)   NOT NULL,
  DIRECCION_DUENO  VARCHAR2(60)   NOT NULL,
  FONO_DUENO       VARCHAR2(15)   NOT NULL,
  EMAIL_DUENO      VARCHAR2(60),
  CONTACTO_EMERG   VARCHAR2(60),
  FONO_EMERG       VARCHAR2(15),
  ID_ESTCIVIL      NUMBER(1)      NOT NULL,
  ID_COMUNA        NUMBER(3)      NOT NULL,
  CONSTRAINT PK_DUENO PRIMARY KEY (NUMRUT_DUENO),
  CONSTRAINT FK_DUENO_ESTADO_CIVIL
    FOREIGN KEY (ID_ESTCIVIL) REFERENCES ESTADO_CIVIL (ID_ESTCIVIL),
  CONSTRAINT FK_DUENO_COMUNA
    FOREIGN KEY (ID_COMUNA)   REFERENCES COMUNA (ID_COMUNA)
);
 
-- Perro: mascota hospedada. Pertenece a un unico dueno y tiene una raza.
-- Se guarda fecha de nacimiento (no la edad) para no desactualizar el dato.
CREATE TABLE PERRO (
  ID_PERRO         NUMBER(10)     NOT NULL,
  NOMBRE_PERRO     VARCHAR2(30)   NOT NULL,
  SEXO_PERRO       VARCHAR2(1)    NOT NULL,
  FECNAC_PERRO     DATE,
  PESO_PERRO       NUMBER(5,2),
  TAMANO_PERRO     VARCHAR2(10)   NOT NULL,
  ESTADO_VACUNAS   VARCHAR2(1)    DEFAULT 'N' NOT NULL,
  CONDICIONES_MED  VARCHAR2(200),
  ALERGIAS         VARCHAR2(200),
  MEDICAMENTOS     VARCHAR2(200),
  ALIMENTACION     VARCHAR2(200),
  IND_SOCIABLE     VARCHAR2(1)    DEFAULT 'S' NOT NULL,
  OBSERVACIONES    VARCHAR2(200),
  ID_RAZA          NUMBER(3)      NOT NULL,
  NUMRUT_DUENO     NUMBER(10)     NOT NULL,
  CONSTRAINT PK_PERRO PRIMARY KEY (ID_PERRO),
  CONSTRAINT FK_PERRO_RAZA
    FOREIGN KEY (ID_RAZA)      REFERENCES RAZA (ID_RAZA),
  CONSTRAINT FK_PERRO_DUENO
    FOREIGN KEY (NUMRUT_DUENO) REFERENCES DUENO (NUMRUT_DUENO),
  CONSTRAINT CK_PERRO_SEXO     CHECK (SEXO_PERRO IN ('M','H')),
  CONSTRAINT CK_PERRO_TAMANO   CHECK (TAMANO_PERRO IN ('PEQUENO','MEDIANO','GRANDE')),
  CONSTRAINT CK_PERRO_VACUNAS  CHECK (ESTADO_VACUNAS IN ('S','N')),
  CONSTRAINT CK_PERRO_SOCIABLE CHECK (IND_SOCIABLE IN ('S','N'))
);
 
-- Trabajador: personal del hotel. Tiene un tipo de trabajo y puede tener un
-- supervisor (auto-relacion). Estado civil y comuna externalizados.
CREATE TABLE TRABAJADOR (
  NUMRUT_TRAB      NUMBER(10)     NOT NULL,
  DVRUT_TRAB       VARCHAR2(1)    NOT NULL,
  APPATERNO_TRAB   VARCHAR2(20)   NOT NULL,
  APMATERNO_TRAB   VARCHAR2(20),
  NOMBRE_TRAB      VARCHAR2(30)   NOT NULL,
  DIRECCION_TRAB   VARCHAR2(60),
  FONO_TRAB        VARCHAR2(15),
  EMAIL_TRAB       VARCHAR2(60),
  FECNAC_TRAB      DATE,
  FECING_TRAB      DATE           NOT NULL,
  SUELDO_TRAB      NUMBER(9),
  ID_TIPO_TRABAJO  NUMBER(2)      NOT NULL,
  ID_ESTCIVIL      NUMBER(1)      NOT NULL,
  ID_COMUNA        NUMBER(3)      NOT NULL,
  NUMRUT_SUPERVISOR NUMBER(10),
  CONSTRAINT PK_TRABAJADOR PRIMARY KEY (NUMRUT_TRAB),
  CONSTRAINT FK_TRAB_TIPO_TRABAJO
    FOREIGN KEY (ID_TIPO_TRABAJO)  REFERENCES TIPO_TRABAJO (ID_TIPO_TRABAJO),
  CONSTRAINT FK_TRAB_ESTADO_CIVIL
    FOREIGN KEY (ID_ESTCIVIL)      REFERENCES ESTADO_CIVIL (ID_ESTCIVIL),
  CONSTRAINT FK_TRAB_COMUNA
    FOREIGN KEY (ID_COMUNA)        REFERENCES COMUNA (ID_COMUNA),
  CONSTRAINT FK_TRAB_SUPERVISOR
    FOREIGN KEY (NUMRUT_SUPERVISOR) REFERENCES TRABAJADOR (NUMRUT_TRAB),
  CONSTRAINT CK_TRAB_SUELDO CHECK (SUELDO_TRAB IS NULL OR SUELDO_TRAB >= 0)
);
 
-- ============================================================================
--  3) TABLA ASOCIATIVA  (N:M  TRABAJADOR <-> SEDE)
--  Un trabajador puede prestar servicios en una o varias sedes, y una sede
--  cuenta con varios trabajadores. La regla "segun el tipo de trabajo" se
--  apoya en TIPO_TRABAJO.IND_MULTISEDE.
-- ============================================================================
CREATE TABLE TRABAJADOR_SEDE (
  NUMRUT_TRAB      NUMBER(10)     NOT NULL,
  ID_SEDE          NUMBER(3)      NOT NULL,
  FECDESDE         DATE           DEFAULT SYSDATE NOT NULL,
  CONSTRAINT PK_TRABAJADOR_SEDE PRIMARY KEY (NUMRUT_TRAB, ID_SEDE),
  CONSTRAINT FK_TRABSEDE_TRABAJADOR
    FOREIGN KEY (NUMRUT_TRAB) REFERENCES TRABAJADOR (NUMRUT_TRAB),
  CONSTRAINT FK_TRABSEDE_SEDE
    FOREIGN KEY (ID_SEDE)     REFERENCES SEDE (ID_SEDE)
);
 
-- ============================================================================
--  4) ESTADIA (hospedaje) y TRASLADO (servicio complementario)
-- ============================================================================
 
-- Estadia: periodo en que un perro se hospeda en una sede. Guarda la historia:
-- un mismo perro puede tener muchas estadias en el tiempo.
CREATE TABLE ESTADIA (
  ID_ESTADIA       NUMBER(10)     NOT NULL,
  FECINI_ESTADIA   DATE           NOT NULL,
  FECTER_ESTADIA   DATE           NOT NULL,
  ESTADO_ESTADIA   VARCHAR2(12)   DEFAULT 'RESERVADA' NOT NULL,
  INSTRUCCIONES    VARCHAR2(200),
  VALOR_ESTADIA    NUMBER(8)      NOT NULL,
  ID_PERRO         NUMBER(10)     NOT NULL,
  ID_SEDE          NUMBER(3)      NOT NULL,
  CONSTRAINT PK_ESTADIA PRIMARY KEY (ID_ESTADIA),
  CONSTRAINT FK_ESTADIA_PERRO
    FOREIGN KEY (ID_PERRO) REFERENCES PERRO (ID_PERRO),
  CONSTRAINT FK_ESTADIA_SEDE
    FOREIGN KEY (ID_SEDE)  REFERENCES SEDE (ID_SEDE),
  CONSTRAINT CK_ESTADIA_FECHAS CHECK (FECTER_ESTADIA >= FECINI_ESTADIA),
  CONSTRAINT CK_ESTADIA_VALOR  CHECK (VALOR_ESTADIA >= 0),
  CONSTRAINT CK_ESTADIA_ESTADO
    CHECK (ESTADO_ESTADIA IN ('RESERVADA','EN_CURSO','FINALIZADA','CANCELADA'))
);
 
-- Traslado: servicio opcional de retiro del perro en el domicilio del dueno.
-- Relacion 1:1 con la estadia (a lo sumo un traslado por estadia -> ID_ESTADIA
-- UNIQUE). Puede asignarse el trabajador que lo realiza.
CREATE TABLE TRASLADO (
  ID_TRASLADO      NUMBER(10)     NOT NULL,
  ID_ESTADIA       NUMBER(10)     NOT NULL,
  DIRECCION_RETIRO VARCHAR2(60)   NOT NULL,
  FECHA_RETIRO     DATE           NOT NULL,
  VALOR_TRASLADO   NUMBER(7)      NOT NULL,
  ESTADO_TRASLADO  VARCHAR2(12)   DEFAULT 'PENDIENTE' NOT NULL,
  NUMRUT_TRAB      NUMBER(10),
  CONSTRAINT PK_TRASLADO PRIMARY KEY (ID_TRASLADO),
  CONSTRAINT UQ_TRASLADO_ESTADIA UNIQUE (ID_ESTADIA),
  CONSTRAINT FK_TRASLADO_ESTADIA
    FOREIGN KEY (ID_ESTADIA)  REFERENCES ESTADIA (ID_ESTADIA),
  CONSTRAINT FK_TRASLADO_TRABAJADOR
    FOREIGN KEY (NUMRUT_TRAB) REFERENCES TRABAJADOR (NUMRUT_TRAB),
  CONSTRAINT CK_TRASLADO_VALOR  CHECK (VALOR_TRASLADO >= 0),
  CONSTRAINT CK_TRASLADO_ESTADO
    CHECK (ESTADO_TRASLADO IN ('PENDIENTE','REALIZADO','CANCELADO'))
);
 
-- ============================================================================
--  5) INDICES SOBRE CLAVES FORANEAS  (buenas practicas de rendimiento)
-- ============================================================================
CREATE INDEX IX_SEDE_COMUNA        ON SEDE (ID_COMUNA);
CREATE INDEX IX_DUENO_ESTCIVIL     ON DUENO (ID_ESTCIVIL);
CREATE INDEX IX_DUENO_COMUNA       ON DUENO (ID_COMUNA);
CREATE INDEX IX_PERRO_RAZA         ON PERRO (ID_RAZA);
CREATE INDEX IX_PERRO_DUENO        ON PERRO (NUMRUT_DUENO);
CREATE INDEX IX_TRAB_TIPO          ON TRABAJADOR (ID_TIPO_TRABAJO);
CREATE INDEX IX_TRAB_ESTCIVIL      ON TRABAJADOR (ID_ESTCIVIL);
CREATE INDEX IX_TRAB_COMUNA        ON TRABAJADOR (ID_COMUNA);
CREATE INDEX IX_TRAB_SUPERVISOR    ON TRABAJADOR (NUMRUT_SUPERVISOR);
CREATE INDEX IX_TRABSEDE_SEDE      ON TRABAJADOR_SEDE (ID_SEDE);
CREATE INDEX IX_ESTADIA_PERRO      ON ESTADIA (ID_PERRO);
CREATE INDEX IX_ESTADIA_SEDE       ON ESTADIA (ID_SEDE);
CREATE INDEX IX_TRASLADO_TRAB      ON TRASLADO (NUMRUT_TRAB);
 
-- ============================================================================
--  6) COMENTARIOS DEL MODELO (documentacion)
-- ============================================================================
COMMENT ON TABLE COMUNA          IS 'Comunas donde residen duenos/trabajadores y se ubican las sedes';
COMMENT ON TABLE ESTADO_CIVIL    IS 'Catalogo de estado civil de duenos y trabajadores';
COMMENT ON TABLE RAZA            IS 'Catalogo de razas de perro';
COMMENT ON TABLE TIPO_TRABAJO    IS 'Categoria/funcion del trabajador; IND_MULTISEDE habilita varias sedes';
COMMENT ON TABLE SEDE            IS 'Establecimiento fisico del hotel canino, con su capacidad';
COMMENT ON TABLE DUENO           IS 'Persona responsable de uno o mas perros';
COMMENT ON TABLE PERRO           IS 'Perro hospedado; pertenece a un dueno y tiene una raza';
COMMENT ON TABLE TRABAJADOR      IS 'Personal del hotel; puede tener supervisor (auto-relacion)';
COMMENT ON TABLE TRABAJADOR_SEDE IS 'Asignacion N:M de trabajadores a sedes';
COMMENT ON TABLE ESTADIA         IS 'Periodo de hospedaje de un perro en una sede (historial)';
COMMENT ON TABLE TRASLADO        IS 'Servicio opcional de retiro a domicilio; 1:1 con la estadia';
 
